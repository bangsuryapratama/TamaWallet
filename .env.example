# TamaWallet Environment Configuration
# ========================================

# Supabase Configuration
# Dapatkan dari Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# Mendukung salah satu dari kedua penamaan di bawah ini:
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
# atau
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key-here

# Catatan: Jangan sertakan SUPABASE_SERVICE_ROLE_KEY di frontend!
# Kunci service-role hanya digunakan pada server-side yang aman untuk migration / background tasks.
